@prefix ns1: <http://example.org/t/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:S_A a sh:NodeShape ;
    sh:property _:Nf2e9531f27d64bd4bd47eb92a7c74404,
        ns1:P5 ;
    sh:targetClass ns1:A .

ns1:S_B a sh:NodeShape ;
    sh:property [ sh:or ( [ ns1:support 2 ;
                        sh:class ns1:A ] [ sh:class ns1:D ] [ sh:class ns1:B ] ) ;
            sh:path ns1:p ],
        _:Nf2e9531f27d64bd4bd47eb92a7c74404,
        [ sh:class ns1:E ;
            sh:languageIn ( "fr" "en" ) ;
            sh:nodeKind sh:IRIOrLiteral ;
            sh:path ns1:q ],
        ns1:P34 ;
    sh:targetClass ns1:B .

ns1:S_C a sh:NodeShape ;
    sh:property ns1:P50 ;
    sh:targetClass ns1:C .

ns1:S_D a sh:NodeShape ;
    sh:property [ sh:node ns1:S_G ;
            sh:path ns1:q ],
        ns1:P57 ;
    sh:targetClass ns1:D .

ns1:S_E a sh:NodeShape ;
    sh:property [ sh:minCount 2 ;
            sh:minInclusive 4 ;
            sh:path ns1:p ],
        [ sh:class ns1:G ;
            sh:in ( ns1:v1 1 5 ) ;
            sh:minCount 1 ;
            sh:path ns1:p ],
        ns1:P83,
        ns1:P86 ;
    sh:targetClass ns1:E .

ns1:S_F a sh:NodeShape ;
    sh:property _:Nf2e9531f27d64bd4bd47eb92a7c74404 ;
    sh:targetClass ns1:F .

ns1:P34 sh:minInclusive 3 ;
    sh:or ( [ ns1:support 3 ;
                sh:class ns1:B ] [ sh:class ns1:D ] [ sh:class ns1:C ] ) ;
    sh:path ns1:q .

ns1:P5 sh:class ns1:H ;
    sh:minCount 2 ;
    sh:path ns1:q .

ns1:P50 sh:datatype xsd:integer ;
    sh:maxLength 2 ;
    sh:minInclusive 1 ;
    sh:path ns1:p .

ns1:P57 sh:in ( 1 5 ) ;
    sh:minCount 1 ;
    sh:minInclusive 4 ;
    sh:path ns1:q .

ns1:P83 sh:datatype xsd:integer ;
    sh:path ns1:q .

ns1:P86 sh:maxCount 1 ;
    sh:minCount 2 ;
    sh:path ns1:q .

ns1:S_G a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:in ( 5 ns1:v0 ) ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path ns1:q ] ;
    sh:targetClass ns1:G .

_:Nf2e9531f27d64bd4bd47eb92a7c74404 sh:minInclusive 0 ;
    sh:path ns1:p .

