weso-s:AnnotationProperty a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            ns1:ratio_property_usage 1.0 ;
            sh:in ( owl:AnnotationProperty ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ] ;
    sh:targetClass owl:AnnotationProperty .

