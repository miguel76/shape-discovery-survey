shape:EmissionScenario a sh:NodeShape ;
    rdfs:label "EmissionScenario"@en ;
    sh:property shape:EmissionScenario_acronym,
        shape:EmissionScenario_comment,
        shape:EmissionScenario_label ;
    sh:targetClass <https://w3id.org/hacid/onto/ccso/EmissionScenario> ;
    ns1:background-color "gray" .

shape:EnsembleProjection a sh:NodeShape ;
    rdfs:label "EnsembleProjection"@en ;
    sh:property shape:EnsembleProjection_hasPart,
        shape:EnsembleProjection_label ;
    sh:targetClass <https://w3id.org/hacid/onto/ccso/EnsembleProjection> ;
    ns1:background-color "saddlebrown" .

shape:EnsembleProjectionProduction a sh:NodeShape ;
    rdfs:label "EnsembleProjectionProduction"@en ;
    sh:property shape:EnsembleProjectionProduction_associatedWith,
        shape:EnsembleProjectionProduction_hasComponent,
        shape:EnsembleProjectionProduction_hasMemberSimulation,
        shape:EnsembleProjectionProduction_hasOutput,
        shape:EnsembleProjectionProduction_hasPart,
        shape:EnsembleProjectionProduction_hasProperPart,
        shape:EnsembleProjectionProduction_label,
        shape:EnsembleProjectionProduction_usesModel ;
    sh:targetClass <https://w3id.org/hacid/onto/ccso/EnsembleProjectionProduction> ;
    ns1:background-color "sandybrown" .

