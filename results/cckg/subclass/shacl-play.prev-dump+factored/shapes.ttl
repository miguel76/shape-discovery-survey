    sh:in ( "Representative Concentration Pathway 8.5"@en "Representative Concentration Pathway 7"@en "Representative Concentration Pathway 6"@en "Representative Concentration Pathway 4.5"@en "Representative Concentration Pathway 3.4"@en "Representative Concentration Pathway 2.6"@en "Representative Concentration Pathway 1.9"@en ) ;
    sh:name "label"@en ;
    sh:path rdfs:label .

