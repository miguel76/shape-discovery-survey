@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

shape:SingleProjection_isEquivalentTo_class_0
        sh:class  <https://w3id.org/hacid/onto/ccso/ScenarioBasedProjection> .

shape:Dataset_label  sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:name      "label"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      rdfs:label .

shape:PerturbedParameterClimateEnsembleSimulation_hasComponent_class_1
        sh:class  <https://w3id.org/hacid/onto/ccso/SingleSimulation> .

shape:SharedSocioeconomicPathway_title
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:in              ( "SSP1: Sustainability (\"Taking the Green Road\")"@en "SSP2: Middle of the road"@en "SSP3: Regional rivalry (A Rocky Road)"@en "SSP4: Inequality (A Road Divided)"@en "SSP5: Fossil-Fueled Development (Taking the Highway)"@en ) ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "title"@en ;
        sh:nodeKind        sh:Literal ;
