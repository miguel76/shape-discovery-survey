@prefix dash:  <http://datashapes.org/dash#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://shacl-play.sparna.fr/shapes/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

shape:Dataset_label  dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "CORDEX-CMIP5 output" "CMIP5 output" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:PerturbedParameterClimateEnsembleSimulation_hasComponent_class_1
        sh:class  <https://w3id.org/hacid/onto/ccso/GlobalClimateSimulation> .

shape:SharedSocioeconomicPathway_title
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:in              ( "SSP5: Fossil-Fueled Development (Taking the Highway)"@en "SSP4: Inequality (A Road Divided)"@en "SSP3: Regional rivalry (A Rocky Road)"@en "SSP2: Middle of the road"@en "SSP1: Sustainability (\"Taking the Green Road\")"@en ) ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "title"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://purl.org/dc/terms/title> .

shape:Description_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:hasValue        "Sectors according to climdex.org" ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:DimensionalSpace_basedOnDimensionalSpace_class_0
        sh:class  <https://w3id.org/hacid/onto/data/Continuum> .

shape:SingleSimulation_usesModel_class_1
        sh:class  <https://w3id.org/hacid/onto/ccso/RegionalClimateModel> .

shape:Organization  rdf:type  sh:NodeShape ;
        rdfs:label      "Organization"@en ;
        sh:property     shape:Organization_label , shape:Organization_acronym ;
        sh:targetClass  <https://w3id.org/hacid/onto/top-level/Organization> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "ghostwhite" .

shape:StatisticalProjectionTransformation_hasOutput_class_0
        sh:class  <https://w3id.org/hacid/onto/ccso/SingleProjection> .

shape:DiscreteDimensionalSpace_hasDiscretization
        sh:class     <https://w3id.org/hacid/onto/data/SimpleRegularBinning> ;
        sh:maxCount  1 ;
        sh:name      "hasDiscretization"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <https://w3id.org/hacid/onto/data/hasDiscretization> .

shape:Action_hasOutput_class_0
        sh:class  <https://w3id.org/hacid/onto/ccso/ScenarioBasedProjection> .

shape:DynamicalDownscaling_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:Action_hasOutput
        sh:maxCount  1 ;
        sh:name      "hasOutput"@en ;
        sh:nodeKind  sh:IRI ;
        sh:or        ( shape:Action_hasOutput_class_0 shape:Action_hasOutput_class_1 shape:Action_hasOutput_class_2 ) ;
        sh:path      <https://w3id.org/hacid/onto/data/hasOutput> .

shape:DynamicalDownscaling_hasComponent_class_3
        sh:class  <https://w3id.org/hacid/onto/ccso/ClimateModelIntercomparisonExperiment> .

shape:DataGeneratingProcess_hasComponent_class_2
        sh:class  <https://w3id.org/hacid/onto/ccso/ClimateModelIntercomparisonExperiment> .

shape:SingleSimulation_isDownscalingOf
        sh:maxCount  1 ;
        sh:name      "isDownscalingOf"@en ;
        sh:nodeKind  sh:IRI ;
        sh:or        ( shape:SingleSimulation_isDownscalingOf_class_0 shape:SingleSimulation_isDownscalingOf_class_1 shape:SingleSimulation_isDownscalingOf_class_2 ) ;
        sh:path      <https://w3id.org/hacid/onto/ccso/isDownscalingOf> .

shape:ScenarioBasedProjection_isSpecializationOfVariable
        sh:class     <https://w3id.org/hacid/onto/data/Variable> ;
        sh:name      "isSpecializationOfVariable"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <https://w3id.org/hacid/onto/data/isSpecializationOfVariable> .

shape:ClimateModelIntercomparisonExperiment_acronym
        sh:datatype  xsd:string ;
