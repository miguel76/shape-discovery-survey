        sh:minCount  1 ;
        sh:name      "hasOutput"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <https://w3id.org/hacid/onto/data/hasOutput> .

shape:GeodeticPoint_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:in              ( "Geodetic point -162.0° 39.25°"@en "Geodetic point 141.38° 60.31°"@en "Geodetic point -166.92° 6.08°"@en "Geodetic point -103.39° 43.48°"@en "Geodetic point -123.34° 79.95°"@en "Geodetic point 83.0° 42.5°"@en "Geodetic point -56.06° 70.6°"@en "Geodetic point 177.5° 37.5°"@en "Geodetic point -64.78° 77.61°"@en "Geodetic point 180.0° 90.0°"@en "Geodetic point 0.0° 6.55°"@en "Geodetic point 113.98° 75.74°"@en "Geodetic point 198.0° 39.25°"@en ) ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

