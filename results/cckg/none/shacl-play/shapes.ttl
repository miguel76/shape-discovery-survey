        sh:name      "acronym"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <https://w3id.org/hacid/onto/top-level/acronym> .

shape:DimensionalSpace_hasDiscretization_class_3
        sh:class  <https://w3id.org/hacid/onto/data/SinglePeriodicBinning> .

shape:SimpleRegularBinning_hasResolutionValue
        sh:maxCount  1 ;
        sh:name      "hasResolutionValue"@en ;
        sh:nodeKind  sh:Literal ;
        sh:or        ( shape:SimpleRegularBinning_hasResolutionValue_datatype_0 shape:SimpleRegularBinning_hasResolutionValue_datatype_1 ) ;
        sh:path      <https://w3id.org/hacid/onto/data/hasResolutionValue> .

shape:ConvectionPermittingClimateModel_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:hasValue        "HadREM3-RA11M"@en ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:EnsembleProjection_hasComponent_class_1
        sh:class  <https://w3id.org/hacid/onto/ccso/ScenarioBasedProjection> .

shape:DependentVariable_derivedFromVariable_class_1
        sh:class  <https://w3id.org/hacid/onto/data/DependentVariable> .

shape:Action_comment_datatype_0
        sh:datatype  rdf:langString .

shape:StatisticalProjectionTransformation_hasOutput
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "hasOutput"@en ;
        sh:nodeKind  sh:IRI ;
        sh:or        ( shape:StatisticalProjectionTransformation_hasOutput_class_0 shape:StatisticalProjectionTransformation_hasOutput_class_1 shape:StatisticalProjectionTransformation_hasOutput_class_2 shape:StatisticalProjectionTransformation_hasOutput_class_3 ) ;
        sh:path      <https://w3id.org/hacid/onto/data/hasOutput> .

shape:PerturbedParameterClimateEnsembleSimulation_usesModel
        sh:class     <https://w3id.org/hacid/onto/ccso/GlobalClimateModel> ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "usesModel"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <https://w3id.org/hacid/onto/ccso/usesModel> .

shape:Variable_label  dash:propertyRole
                dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:languageIn      ( "en" ) ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:Description  rdf:type  sh:NodeShape ;
        rdfs:label      "Description"@en ;
        sh:property     shape:Description_comment , shape:Description_label , shape:Description_defines ;
        sh:targetClass  <https://w3id.org/hacid/onto/top-level/Description> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "lightgreen" .

shape:Concept  rdf:type  sh:NodeShape ;
        rdfs:label      "Concept"@en ;
        sh:property     shape:Concept_classifies , shape:Concept_comment , shape:Concept_isMemberOf , shape:Concept_label , shape:Concept_inScheme ;
        sh:targetClass  <https://w3id.org/hacid/onto/top-level/Concept> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "lavender" .

shape:DimensionalSpace_hasExactBoundingRegion_class_1
        sh:class  <https://w3id.org/hacid/onto/data/GeodeticRegion> .

shape:Action_hasComponent_class_3
        sh:class  <https://w3id.org/hacid/onto/data/DataGeneratingProcess> .

shape:DataGeneratingProcess_hasOutput
        sh:class     <https://w3id.org/hacid/onto/data/Dataset> ;
        sh:in        ( <https://w3id.org/hacid/data/cs/mips/cordex-cmip5/output> <https://w3id.org/hacid/data/cs/mips/cmip5/output> ) ;
