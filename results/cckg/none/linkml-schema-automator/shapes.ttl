rdfs:Class a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path owl:hasKey ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path owl:equivalentClass ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:subClassOf ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:comment ],
        [ sh:in ( <https://w3id.org/hacid/onto/top-level> <https://w3id.org/hacid/onto/ccso> <https://w3id.org/hacid/onto/data> ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path owl:disjointWith ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path owl:unionOf ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:order 0 ;
            sh:path example:id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path owl:intersectionOf ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path owl:versionInfo ] ;
    sh:targetClass rdfs:Class .

rdfs:Datatype a sh:NodeShape ;
    sh:closed true ;
