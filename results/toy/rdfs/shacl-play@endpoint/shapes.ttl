@prefix dash:  <http://datashapes.org/dash#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://shacl-play.sparna.fr/shapes/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

shape:ClimateModel_releaseDate
        sh:datatype  xsd:date ;
        sh:maxCount  1 ;
        sh:name      "releaseDate"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/releaseDate> .

shape:Institution_country
        sh:datatype  xsd:string ;
        sh:in        ( "IT" "FR" "DE" "US" ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "country"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/country> .

shape:EarthSystemModel_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "CESM2" "IPSL-CM6A-LR" "MPI-ESM1-2-HR" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:ClimateModel_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "CESM2" "CMCC-CM2-SR5" "IPSL-CM6A-LR" "MPI-ESM1-2-HR" "Toy energy-balance model" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:  rdf:type  <http://www.w3.org/2002/07/owl#Ontology> ;
        <http://purl.org/dc/terms/abstract>
                "Generated by SHACL Play!"@en ;
        <http://purl.org/dc/terms/created>
                "2026-09-25T06:25:49.058Z"^^xsd:dateTime .

shape:EarthSystemModel_developedBy
        sh:class     <http://example.org/toy/Institution> ;
        sh:in        ( <http://example.org/toy/inst_ncar> <http://example.org/toy/inst_ipsl> <http://example.org/toy/inst_mpi> ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "developedBy"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/developedBy> .

shape:Institution_label
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:languageIn      ( "en" "fr" "it" ) ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:ClimateModel_developedBy
        sh:in        ( <http://example.org/toy/inst_ncar> <http://example.org/toy/inst_cmcc> <http://example.org/toy/inst_ipsl> <http://example.org/toy/inst_mpi> <http://example.org/toy/p_dan> ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "developedBy"@en ;
        sh:nodeKind  sh:IRI ;
        sh:or        ( shape:ClimateModel_developedBy_class_0 shape:ClimateModel_developedBy_class_1 ) ;
        sh:path      <http://example.org/toy/developedBy> .

shape:ClimateModel_horizontalResolutionKm
        sh:in        ( 100.0 "approx. 100" 250.0 5000.0 ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "horizontalResolutionKm"@en ;
        sh:nodeKind  sh:Literal ;
        sh:or        ( shape:ClimateModel_horizontalResolutionKm_datatype_0 shape:ClimateModel_horizontalResolutionKm_datatype_1 ) ;
        sh:path      <http://example.org/toy/horizontalResolutionKm> .

shape:Simulation  rdf:type  sh:NodeShape ;
        rdfs:label      "Simulation"@en ;
        sh:property     shape:Simulation_author , shape:Simulation_usesModel , shape:Simulation_usesScenario , shape:Simulation_outputVariable , shape:Simulation_doi , shape:Simulation_period ;
        sh:targetClass  <http://example.org/toy/Simulation> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "bisque" .

shape:ClimateModel_horizontalResolutionKm_datatype_0
        sh:datatype  xsd:decimal .

shape:Simulation_usesModel
        sh:class     <http://example.org/toy/ClimateModel> ;
        sh:maxCount  1 ;
        sh:name      "usesModel"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/usesModel> .

shape:EarthSystemModel_releaseDate
        sh:datatype  xsd:date ;
        sh:in        ( "2018-09-01"^^xsd:date "2018-06-01"^^xsd:date "2019-01-15"^^xsd:date ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "releaseDate"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/releaseDate> .

shape:Variable  rdf:type  sh:NodeShape ;
        rdfs:label      "Variable"@en ;
        sh:property     shape:Variable_unit , shape:Variable_shortName , shape:Variable_label ;
        sh:targetClass  <http://example.org/toy/Variable> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "teal" .

shape:Person_affiliation
        sh:class     <http://example.org/toy/Institution> ;
        sh:minCount  1 ;
        sh:name      "affiliation"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/affiliation> .

shape:Simulation_usesScenario_class_1
        sh:class  <http://example.org/toy/Variable> .

shape:Scenario_radiativeForcing
        sh:datatype  xsd:decimal ;
        sh:maxCount  1 ;
        sh:name      "radiativeForcing"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/radiativeForcing> .

shape:Scenario  rdf:type  sh:NodeShape ;
        rdfs:label      "Scenario"@en ;
        sh:property     shape:Scenario_radiativeForcing , shape:Scenario_label ;
        sh:targetClass  <http://example.org/toy/Scenario> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "tan" .

shape:ClimateModel  rdf:type  sh:NodeShape ;
        rdfs:label      "ClimateModel"@en ;
        sh:property     shape:ClimateModel_releaseDate , shape:ClimateModel_horizontalResolutionKm , shape:ClimateModel_developedBy , shape:ClimateModel_label ;
        sh:targetClass  <http://example.org/toy/ClimateModel> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "beige" .

shape:Variable_shortName
        sh:datatype  xsd:string ;
        sh:in        ( "pr" "tas" "psl" "tos" ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "shortName"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/shortName> .

shape:Person_name  dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "Dan Brown" "Alice Martin" "Bob Schmidt" "Carla Rossi" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "name"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://example.org/toy/name> .

shape:Person  rdf:type  sh:NodeShape ;
        rdfs:label      "Person"@en ;
        sh:property     shape:Person_email , shape:Person_name , shape:Person_affiliation ;
        sh:targetClass  <http://example.org/toy/Person> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "darkmagenta" .

shape:Simulation_doi  sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:name      "doi"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/doi> .

shape:Simulation_usesScenario_class_0
        sh:class  <http://example.org/toy/Scenario> .

shape:EarthSystemModel_horizontalResolutionKm
        sh:datatype  xsd:decimal ;
        sh:in        ( 100.0 250.0 ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "horizontalResolutionKm"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/horizontalResolutionKm> .

shape:EarthSystemModel
        rdf:type        sh:NodeShape ;
        rdfs:label      "EarthSystemModel"@en ;
        sh:property     shape:EarthSystemModel_releaseDate , shape:EarthSystemModel_horizontalResolutionKm , shape:EarthSystemModel_developedBy , shape:EarthSystemModel_label ;
        sh:targetClass  <http://example.org/toy/EarthSystemModel> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "lightgreen" .

shape:Simulation_period
        sh:maxCount  1 ;
        sh:name      "period"@en ;
        sh:nodeKind  sh:BlankNode ;
        sh:path      <http://example.org/toy/period> .

shape:Institution  rdf:type  sh:NodeShape ;
        rdfs:label      "Institution"@en ;
        sh:property     shape:Institution_homepage , shape:Institution_country , shape:Institution_label ;
        sh:targetClass  <http://example.org/toy/Institution> ;
        <https://shacl-play.sparna.fr/ontology#background-color>
                "cadetblue" .

shape:Variable_label  dash:propertyRole
                dash:LabelRole ;
        sh:datatype        rdf:langString ;
        sh:in              ( "Precipitation"@en "Near-Surface Air Temperature"@en "Sea Level Pressure"@en "Sea Surface Temperature"@en ) ;
        sh:languageIn      ( "en" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:Simulation_usesScenario
        sh:in        ( <http://example.org/toy/ssp585> <http://example.org/toy/ssp245> <http://example.org/toy/ssp126> <http://example.org/toy/historical> <http://example.org/toy/var_pr> ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "usesScenario"@en ;
        sh:nodeKind  sh:IRI ;
        sh:or        ( shape:Simulation_usesScenario_class_0 shape:Simulation_usesScenario_class_1 ) ;
        sh:path      <http://example.org/toy/usesScenario> .

shape:Simulation_outputVariable
        sh:class     <http://example.org/toy/Variable> ;
        sh:minCount  1 ;
        sh:name      "outputVariable"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/outputVariable> .

shape:ClimateModel_developedBy_class_1
        sh:class  <http://example.org/toy/Person> .

shape:Institution_homepage
        sh:maxCount  1 ;
        sh:name      "homepage"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/homepage> .

shape:Scenario_label  dash:propertyRole
                dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "historical" "SSP5-8.5" "SSP2-4.5" "SSP1-2.6" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "label"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            rdfs:label .

shape:Simulation_author
        sh:class     <http://example.org/toy/Person> ;
        sh:minCount  1 ;
        sh:name      "author"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://example.org/toy/author> .

shape:Variable_unit  sh:datatype  xsd:string ;
        sh:in        ( "kg m-2 s-1" "K" "Pa" "degC" ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "unit"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/unit> .

shape:Person_email  sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:name      "email"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://example.org/toy/email> .

shape:ClimateModel_developedBy_class_0
        sh:class  <http://example.org/toy/Institution> .

shape:ClimateModel_horizontalResolutionKm_datatype_1
        sh:datatype  xsd:string .
