@prefix dash: <http://datashapes.org/dash#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://shacl-play.sparna.fr/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://shacl-play.sparna.fr/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape: a owl:Ontology ;
    dcterms:abstract "Generated by SHACL Play!"@en ;
    dcterms:created "2026-09-25T06:25:35.640000+00:00"^^xsd:dateTime .

shape:ClimateModel a sh:NodeShape ;
    rdfs:label "ClimateModel"@en ;
    sh:property shape:ClimateModel_developedBy,
        shape:ClimateModel_horizontalResolutionKm,
        shape:ClimateModel_label,
        shape:ClimateModel_releaseDate ;
    sh:targetClass <http://example.org/toy/ClimateModel> ;
    ns1:background-color "firebrick" .

shape:EarthSystemModel a sh:NodeShape ;
    rdfs:label "EarthSystemModel"@en ;
    sh:property shape:EarthSystemModel_developedBy,
        shape:EarthSystemModel_horizontalResolutionKm,
        shape:EarthSystemModel_label,
        shape:EarthSystemModel_releaseDate ;
    sh:targetClass <http://example.org/toy/EarthSystemModel> ;
    ns1:background-color "orchid" .

shape:Institution a sh:NodeShape ;
    rdfs:label "Institution"@en ;
    sh:property shape:Institution_country,
        shape:Institution_homepage,
        shape:Institution_label ;
    sh:targetClass <http://example.org/toy/Institution> ;
    ns1:background-color "azure" .

shape:Person a sh:NodeShape ;
    rdfs:label "Person"@en ;
    sh:property shape:Person_affiliation,
        shape:Person_email,
        shape:Person_name ;
    sh:targetClass <http://example.org/toy/Person> ;
    ns1:background-color "snow" .

shape:Scenario a sh:NodeShape ;
    rdfs:label "Scenario"@en ;
    sh:property shape:Scenario_label,
        shape:Scenario_radiativeForcing ;
    sh:targetClass <http://example.org/toy/Scenario> ;
    ns1:background-color "oldlace" .

shape:Simulation a sh:NodeShape ;
    rdfs:label "Simulation"@en ;
    sh:property shape:Simulation_author,
        shape:Simulation_doi,
        shape:Simulation_outputVariable,
        shape:Simulation_period,
        shape:Simulation_usesModel,
        shape:Simulation_usesScenario ;
    sh:targetClass <http://example.org/toy/Simulation> ;
    ns1:background-color "darkred" .

shape:Variable a sh:NodeShape ;
    rdfs:label "Variable"@en ;
    sh:property shape:Variable_label,
        shape:Variable_shortName,
        shape:Variable_unit ;
    sh:targetClass <http://example.org/toy/Variable> ;
    ns1:background-color "palevioletred" .

shape:ClimateModel_developedBy sh:in ( <http://example.org/toy/p_dan> <http://example.org/toy/inst_mpi> <http://example.org/toy/inst_ipsl> <http://example.org/toy/inst_cmcc> <http://example.org/toy/inst_ncar> ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "developedBy"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( shape:ClimateModel_developedBy_class_0 shape:ClimateModel_developedBy_class_1 ) ;
    sh:path <http://example.org/toy/developedBy> .

shape:ClimateModel_developedBy_class_0 sh:class <http://example.org/toy/Person> .

shape:ClimateModel_developedBy_class_1 sh:class <http://example.org/toy/Institution> .

shape:ClimateModel_horizontalResolutionKm sh:in ( 5000.0 100.0 250.0 "approx. 100" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "horizontalResolutionKm"@en ;
    sh:nodeKind sh:Literal ;
    sh:or ( shape:ClimateModel_horizontalResolutionKm_datatype_0 shape:ClimateModel_horizontalResolutionKm_datatype_1 ) ;
    sh:path <http://example.org/toy/horizontalResolutionKm> .

shape:ClimateModel_horizontalResolutionKm_datatype_0 sh:datatype xsd:decimal .

shape:ClimateModel_horizontalResolutionKm_datatype_1 sh:datatype xsd:string .

shape:ClimateModel_label dash:propertyRole dash:LabelRole ;
    sh:datatype xsd:string ;
    sh:in ( "Toy energy-balance model" "MPI-ESM1-2-HR" "IPSL-CM6A-LR" "CMCC-CM2-SR5" "CESM2" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "label"@en ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

shape:ClimateModel_releaseDate sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "releaseDate"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/releaseDate> .

shape:EarthSystemModel_developedBy sh:class <http://example.org/toy/Institution> ;
    sh:in ( <http://example.org/toy/inst_mpi> <http://example.org/toy/inst_ipsl> <http://example.org/toy/inst_ncar> ) ;
    sh:name "developedBy"@en ;
    sh:path <http://example.org/toy/developedBy> .

shape:EarthSystemModel_horizontalResolutionKm sh:datatype xsd:decimal ;
    sh:in ( 100.0 250.0 ) ;
    sh:name "horizontalResolutionKm"@en ;
    sh:path <http://example.org/toy/horizontalResolutionKm> .

shape:EarthSystemModel_label dash:propertyRole dash:LabelRole ;
    sh:in ( "MPI-ESM1-2-HR" "IPSL-CM6A-LR" "CESM2" ) ;
    sh:name "label"@en ;
    sh:path rdfs:label .

shape:EarthSystemModel_releaseDate sh:in ( "2019-01-15"^^xsd:date "2018-06-01"^^xsd:date "2018-09-01"^^xsd:date ) ;
    sh:minCount 1 ;
    sh:name "releaseDate"@en ;
    sh:path <http://example.org/toy/releaseDate> .

shape:Institution_country sh:datatype xsd:string ;
    sh:in ( "US" "DE" "FR" "IT" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "country"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/country> .

shape:Institution_homepage sh:maxCount 1 ;
    sh:name "homepage"@en ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/toy/homepage> .

shape:Institution_label dash:propertyRole dash:LabelRole ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "fr" "it" ) ;
    sh:minCount 1 ;
    sh:name "label"@en ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

shape:Person_affiliation sh:class <http://example.org/toy/Institution> ;
    sh:minCount 1 ;
    sh:name "affiliation"@en ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/toy/affiliation> .

shape:Person_email sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "email"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/email> .

shape:Person_name dash:propertyRole dash:LabelRole ;
    sh:datatype xsd:string ;
    sh:in ( "Dan Brown" "Carla Rossi" "Bob Schmidt" "Alice Martin" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "name"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/name> .

shape:Scenario_label dash:propertyRole dash:LabelRole ;
    sh:datatype xsd:string ;
    sh:in ( "SSP5-8.5" "SSP2-4.5" "SSP1-2.6" "historical" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "label"@en ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

shape:Scenario_radiativeForcing sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:name "radiativeForcing"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/radiativeForcing> .

shape:Simulation_author sh:class <http://example.org/toy/Person> ;
    sh:minCount 1 ;
    sh:name "author"@en ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/toy/author> .

shape:Simulation_doi sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "doi"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/doi> .

shape:Simulation_outputVariable sh:class <http://example.org/toy/Variable> ;
    sh:minCount 1 ;
    sh:name "outputVariable"@en ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/toy/outputVariable> .

shape:Simulation_period sh:maxCount 1 ;
    sh:name "period"@en ;
    sh:nodeKind sh:BlankNode ;
    sh:path <http://example.org/toy/period> .

shape:Simulation_usesModel sh:class <http://example.org/toy/ClimateModel> ;
    sh:maxCount 1 ;
    sh:name "usesModel"@en ;
    sh:nodeKind sh:IRI ;
    sh:path <http://example.org/toy/usesModel> .

shape:Simulation_usesScenario sh:in ( <http://example.org/toy/var_pr> <http://example.org/toy/historical> <http://example.org/toy/ssp126> <http://example.org/toy/ssp245> <http://example.org/toy/ssp585> ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "usesScenario"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( shape:Simulation_usesScenario_class_0 shape:Simulation_usesScenario_class_1 ) ;
    sh:path <http://example.org/toy/usesScenario> .

shape:Simulation_usesScenario_class_0 sh:class <http://example.org/toy/Variable> .

shape:Simulation_usesScenario_class_1 sh:class <http://example.org/toy/Scenario> .

shape:Variable_label dash:propertyRole dash:LabelRole ;
    sh:datatype rdf:langString ;
    sh:in ( "Sea Surface Temperature"@en "Near-Surface Air Temperature"@en "Sea Level Pressure"@en "Precipitation"@en ) ;
    sh:languageIn ( "en" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "label"@en ;
    sh:nodeKind sh:Literal ;
    sh:path rdfs:label .

shape:Variable_shortName sh:datatype xsd:string ;
    sh:in ( "tos" "tas" "psl" "pr" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "shortName"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/shortName> .

shape:Variable_unit sh:datatype xsd:string ;
    sh:in ( "degC" "K" "Pa" "kg m-2 s-1" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "unit"@en ;
    sh:nodeKind sh:Literal ;
    sh:path <http://example.org/toy/unit> .

